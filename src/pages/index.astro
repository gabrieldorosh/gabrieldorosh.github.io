---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TravelCard from "../components/TravelCard.astro";
import portrait from "../assets/about/portrait-lego.jpeg";
import heroBackground from "../assets/hero/hero-background.jpg";
import japanVan from "../assets/travel/japan_van.png";
import austrianAlps from "../assets/travel/austrian-alps.jpg";
import nara from "../assets/travel/nara.jpg";

const publishedProjects = (await getCollection("projects", ({ data }) => !data.draft && data.listed)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = publishedProjects.filter(({ data }) => data.featured).slice(0, 3);
const leadProject = featuredProjects[0];
const secondaryProjects = featuredProjects.slice(1);

const homePolaroids = [
  {
    image: japanVan,
    title: "Inside our kei van we spent a summer living and travelling in",
    date: "2022",
    alt: "A van used while travelling across Japan",
    rotation: -3.2,
  },
  {
    image: austrianAlps,
    title: "The view from the top of the Austrian Alps",
    date: "2016",
    alt: "Snow-covered mountains in the Austrian Alps",
    rotation: 2.4,
  },
  {
    image: nara,
    title: "The very respectful deer found in Nara Park",
    date: "2023",
    alt: "Deer in Nara Park, Japan",
    rotation: -1.1,
  },
];
---

<BaseLayout>
  <section
    class="home-hero"
    aria-labelledby="home-title"
    data-header-threshold
    style={`--home-hero-image: url("${heroBackground.src}")`}
  >
    <div class="container home-hero__grid">
      <div class="home-hero__copy" data-reveal>
        <p class="eyebrow">BSc Computer Science graduate</p>
        <h1 id="home-title">Gabriel Dorosh</h1>
        <p class="home-hero__tagline">
          Passionate computer science graduate and software engineer working on applied machine learning, backend, and full-stack dev.
        </p>
        <p class="home-hero__intro">
          Recently, I have completed my a predictive analysis dissertation on upcoming Counter-Strike performance, built on a dataset of 63,010 player-map records, a property-booking platform, 
          and infrastructure for a 250+ member gaming community.
        </p>
        <p class="home-hero__location">Based in Maidenhead, UK · Open to relocation</p>
      </div>

      <aside class="home-hero__profile" data-reveal style="--card-index: 1">
        <figure class="home-hero__portrait">
          <div class="home-hero__portrait-frame">
            <Image
              src={portrait}
              alt="Gabriel Dorosh seated beside large orange LEGO figures in Japan"
              widths={[420, 640, 840]}
              sizes="(max-width: 760px) 82vw, 31vw"
              loading="eager"
            />
          </div>
        </figure>
        <div class="home-hero__actions">
          <a class="button button--primary" href="/projects/">Explore my work</a>
          <a class="button button--secondary" href="/cv/">View my CV</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section home-work">
    <div class="container">
      <SectionHeading
        eyebrow="Featured projects"
        title="A few of my favourite projects"
        description="Featuerd here is my predictive analysis dissertation, a full-stack property-booking platform, and a QR encoder implemented from a given specification."
        href="/projects/"
        linkLabel={<>View all my projects <ArrowRight class="text-link__icon" aria-hidden="true" size={15} stroke-width={2} /></>}
      />

      <div class="project-showcase">
        {leadProject && <ProjectCard project={leadProject} layout="wide" eager />}
        {
          secondaryProjects.length > 0 && (
            <div class="project-showcase__pair">
              {secondaryProjects.map((project, index) => (
                <ProjectCard project={project} index={index + 1} />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section home-personal">
    <div class="container home-personal__grid">
      <div class="home-personal__copy" data-reveal>
        <!-- <p class="eyebrow">More than just code</p> -->
        <h2>Travelling, mountains, and more</h2>
        <p>
          I spent summers at my uncle's white-water rafting centre, during the winters I learned to ski with him and my cousins in the Austrian Alps. 
          I've also spent a season teaching skiing in Japan and for the rest of the year I was travelling from tip to toe of the country in a tiny kei van.
        </p>
        <a class="text-link" href="/about/">
          Find out more about me
          <ArrowRight class="text-link__icon" aria-hidden="true" size={15} stroke-width={2} />
        </a>
      </div>

      <div
        class="home-polaroids"
        role="group"
        aria-label="A small selection of travel photographs"
      >
        {
          homePolaroids.map((story, index) => (
            <TravelCard {...story} index={index} focusable />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
