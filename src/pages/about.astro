---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TravelCard from "../components/TravelCard.astro";
import { siteConfig } from "../config/site";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import portrait from "../assets/about/portrait-japan-selfie.jpeg";
import japanVan from "../assets/travel/japan_van.png";
import japanView from "../assets/travel/japan_view.jpg";
import kyoto from "../assets/travel/kyoto.JPG";
import austrianAlps from "../assets/travel/austrian-alps.jpg";
import england from "../assets/travel/england.jpg";
import amsterdam from "../assets/travel/amsterdam.jpg";
import sapporo from "../assets/travel/sapporo.jpg";
import dorms from "../assets/travel/dorms.jpg";
import nara from "../assets/travel/nara.JPG";

const travelStories = [
  {
    image: japanVan,
    alt: "A van used while travelling across Japan",
    rotation: -2.2,
    title: "Our little kei van",
    date: "Japan · Summer 2023",
    description: "We drove this kei van from Hokkaido to Kyushu, using it as both transport and home along the way.",
  },
  {
    image: japanView,
    alt: "A mountain view from a ski resort in Japan",
    rotation: 1.4,
    title: "First tracks above the clouds",
    date: "Japan · Winter 2022",
    description: "One of the clearest mornings of my ski season, with fresh snow and the clouds sitting below the resort.",
  },
  {
    image: kyoto,
    alt: "A street scene in Kyoto",
    rotation: -0.8,
    title: "Evening walk in Kyoto",
    date: "Kyoto · Summer 2023",
    description: "A street I photographed during an evening walk through Kyoto.",
  },
  {
    image: austrianAlps,
    alt: "Snow-covered mountains in the Austrian Alps",
    rotation: 2.1,
    title: "Winter in the Austrian Alps",
    date: "Austria · Winter",
    description: "I learned to ski in these mountains near my family and still return whenever I can.",
  },
  {
    image: england,
    alt: "A countryside walk in England",
    rotation: -1.5,
    title: "A slower pace in England",
    date: "England · Spring 2024",
    description: "A long countryside walk close to home between bigger trips.",
  },
  {
    image: amsterdam,
    alt: "A canal-side view in Amsterdam",
    rotation: 1.1,
    title: "Canals at dusk",
    date: "Amsterdam · April 2025",
    description: "Canals, bicycles, and the last light of an April evening.",
  },
  {
    image: sapporo,
    alt: "Bells at the top of a mountain near Sapporo",
    rotation: -1.9,
    title: "Summit bells near Sapporo",
    date: "Hokkaido · January 2023",
    description: "Bells at the top of a mountain near Sapporo in the middle of a Hokkaido winter.",
  },
  {
    image: dorms,
    alt: "A ski-resort dorm room",
    rotation: 0.8,
    title: "Dorm life at the ski resort",
    date: "Japan · December 2022",
    description: "The staff dorm was cramped and cold, but sharing it with the other instructors was part of the season.",
  },
  {
    image: nara,
    alt: "Deer in Nara Park, Japan",
    rotation: -1.2,
    title: "Morning with the deer in Nara",
    date: "Nara · June 2023",
    description: "Deer roaming through Nara Park on one of our mornings in the city.",
  },
];
---

<BaseLayout
  title="About"
  description="About Gabriel Dorosh: software developer, computer science graduate, ski instructor, and traveller."
>
  <section class="page-hero page-hero--about">
    <div class="container page-hero__inner">
      <div data-reveal>
        <p class="eyebrow">About</p>
        <h1>A little more about me</h1>
      </div>
      <p class="page-hero__intro" data-reveal style="--card-index: 1">
        I learned to ski in the Austrian Alps, taught skiing in Japan, and travelled
        the country in a kei van.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-intro">
      <figure class="about-intro__portrait" data-reveal>
        <div class="about-intro__portrait-frame">
          <Image
            src={portrait}
            alt="A close portrait of Gabriel Dorosh while travelling in Japan"
            widths={[480, 760, 1000]}
            sizes="(max-width: 760px) 88vw, 36vw"
            loading="eager"
          />
        </div>
        <figcaption>Tomonoura, Japan · 2023</figcaption>
      </figure>

      <div class="about-intro__copy" data-reveal style="--card-index: 1">
        <p class="eyebrow">Beyond the work</p>
        <h2>From the Austrian Alps to a ski season in Japan</h2>
        <p>
          I learned to ski in the Austrian Alps near my family and spent summers
          working at my family's white-water rafting centre. Between changing
          conditions and looking after guests, I learned to communicate clearly,
          share responsibility, and make decisions quickly.
        </p>
        <p>
          I later spent a season in Japan as a ski instructor. Teaching international
          guests at temperatures as low as -20°C, often in heavy snowfall, meant
          changing each lesson to suit the person and the conditions in front of us.
        </p>
        <p>
          After the season, my girlfriend and I travelled from Hokkaido to Kyushu and
          back in a tiny kei van. Living out of the van kept the trip slow, cheap, and
          close to everyday life.
        </p>
        <div class="about-intro__actions" role="group" aria-label="Contact and CV">
          <a class="text-link" href={`mailto:${siteConfig.email}`}>
            Contact me
            <ArrowUpRight
              class="text-link__icon text-link__icon--outbound"
              aria-hidden="true"
              size={15}
              stroke-width={2}
            />
          </a>
          <a class="text-link" href="/cv/">
            View my CV
            <ArrowRight class="text-link__icon" aria-hidden="true" size={15} stroke-width={2} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section travel-section">
    <div class="container">
      <SectionHeading
        eyebrow="Travel log"
        title="Places I still think about"
        description="Nine photographs from Japan, Austria, England, and Amsterdam."
      />
      <div class="travel-grid">
        {
          travelStories.map((story, index) => (
            <TravelCard {...story} index={index} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
