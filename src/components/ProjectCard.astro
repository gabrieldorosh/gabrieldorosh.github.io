---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";

interface Props {
  project: any;
  layout?: "standard" | "wide";
  eager?: boolean;
  index?: number;
}

const { project, layout = "standard", eager = false, index = 0 } = Astro.props;
const { data } = project;
const projectHref = `/projects/${project.id}/`;
const cardCover = data.homeCover ?? data.cover;
---

<article
  class:list={["project-card", `project-card--${layout}`]}
  style={`--project-accent: ${data.accent}; --card-index: ${index}`}
  data-reveal
>
  <a class="project-card__media" href={projectHref} aria-label={`Read the ${data.title} case study`}>
    {
      cardCover ? (
        <Image
          src={cardCover}
          alt={`${data.title} project preview`}
          loading={eager ? "eager" : "lazy"}
          widths={[480, 768, 1200]}
          sizes={layout === "wide"
              ? "(max-width: 760px) 100vw, 60vw"
              : "(max-width: 760px) 100vw, 45vw"}
        />
      ) : (
        <div class="project-card__fallback" aria-hidden="true">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{data.shortTitle}</strong>
        </div>
      )
    }
  </a>

  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{data.type}</span>
      <span>{data.year}</span>
    </div>
    <h3><a href={projectHref}>{data.title}</a></h3>
    <p>{data.summary}</p>
    <ul class="tag-list" aria-label="Technologies and skills">
      {
        data.technologies.slice(0, 4).map((technology: string) => <li>{technology}</li>)
      }
    </ul>
    <a class="text-link" href={projectHref}>
      Read case study
      <ArrowRight class="text-link__icon" aria-hidden="true" size={15} stroke-width={2} />
    </a>
  </div>
</article>
